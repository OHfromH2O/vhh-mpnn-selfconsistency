# --- 로컬 환경 -------------------------------------------------------
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- 외부 코드 (노트북 셀 [20]이 클론함) -----------------------------
third_party/

# --- 재생성 가능한 대용량 중간 산출물 --------------------------------
# ColabFold가 MSA 서버에서 받아오는 정렬 파일. 13건 합계 약 94 MB이며
# 결과가 아니라 입력이므로 추적하지 않습니다. 재실행하면 다시 만들어집니다.
work/03_refold/S2_colabfold/*.a3m
work/03_refold/S2_colabfold/*.m8
work/03_refold/S2_colabfold/*.tar.gz
work/03_refold/S2_colabfold/*_env
work/03_refold/S2_colabfold/*_pairgreedy

# --- 원본 다운로드 ---------------------------------------------------
# RCSB에서 받는 원본 구조. 노트북이 자동으로 내려받습니다.
data/raw/

# --- 기타 -------------------------------------------------------------
*.zip

# --- 델타 A: PyRosetta 이완 구조 -------------------------------------
# 설계 65건 x N_REPEAT회. 셀 [45] 재실행으로 재생성됩니다.
# 집계값은 work/05_rosetta/rosetta_interface*.csv 에 남습니다.
work/05_rosetta/relaxed/

# --- WSL2 Linux 환경 (델타 A/B) --------------------------------------
# PyRosetta·PyMOL은 네이티브 Windows를 지원하지 않습니다.
# Windows의 .venv(uv, 3.11)와 별개로 WSL2에 3.10 환경을 둡니다.
.venv-linux/

# --- 지원서 초안 (공개 금지) -----------------------------------------
# 이 레포는 공개 포트폴리오입니다. 지원서·개인정보는 추적하지 않습니다.
_application/
